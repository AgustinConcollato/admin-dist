<IfModule mod_mime.c>
  AddType application/manifest+json .webmanifest
</IfModule>

# El service worker y el manifest se revalidan siempre, para que una version
# vieja no quede cacheada e impida las actualizaciones de la app.
<IfModule mod_headers.c>
  <FilesMatch "^(sw|registerSW)\.js$">
    Header set Cache-Control "public, max-age=0, must-revalidate"
  </FilesMatch>
  <FilesMatch "^manifest\.webmanifest$">
    Header set Cache-Control "public, max-age=0, must-revalidate"
  </FilesMatch>
</IfModule>

<IfModule mod_rewrite.c>
  RewriteEngine On
  RewriteBase /

  RewriteRule ^index\.html$ - [L]

  # /v2 y todo lo que cuelgue de el quedan fuera del fallback a index.html
  RewriteCond %{REQUEST_FILENAME} !-f
  RewriteCond %{REQUEST_FILENAME} !-d
  RewriteRule ^v2(/.*)?$ /v2/index.html [L]

  RewriteCond %{REQUEST_FILENAME} !-f
  RewriteCond %{REQUEST_FILENAME} !-d
  RewriteRule . /index.html [L]
</IfModule>